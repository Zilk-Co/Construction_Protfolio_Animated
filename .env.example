# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
# This template documents every variable the API server reads.

# PostgreSQL connection string (Neon/Supabase/RDS). Required.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# HTTP port for the API server.
PORT=5000

# Signing secret for the admin session cookie. Use a long random string.
# In production the server REFUSES to boot without this (min 1 char, strong required).
SESSION_SECRET=change-me-to-a-long-random-string

# Admin panel credentials.
ADMIN_USERNAME=admin
# In production the server REFUSES to boot if this is missing or shorter than 8 chars.
ADMIN_PASSWORD=change-me-strong-password

# Google Gemini API key + model used by the AI assistant (/api/ai/assistant).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Optional: how many proxies to trust in production (Railway/Vercel edge = 1).
TRUST_PROXY=1

# Optional: comma-separated extra origins allowed for CORS (in addition to
# *.vercel.app / *.railway.app / *.onrender.com / localhost).
ALLOWED_ORIGINS=
